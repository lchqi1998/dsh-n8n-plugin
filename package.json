{
  "name": "dsh-n8n-plugin",
  "version": "0.2.0",
  "description": "DeepSeek Harness Web GUI 的 n8n 工作流运维插件：设置页可管理多个 n8n 实例（每个实例一个别名 + 实例地址 + API Key，存储于 ~/.dsh/dsh-n8n-plugin.json），并提供 21 个 Agent 工具（n8n_instances、n8n_workflows、n8n_workflow_get/create/update/delete/publish/validate/clone/tags、n8n_executions、n8n_execution_get/cancel、n8n_wait_execution、n8n_webhook_call、n8n_tags、n8n_tag_create/update/delete、n8n_credentials、n8n_api）。",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib/**/*.js",
    "client/**/*.js",
    "knowledge",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "n8n",
    "workflow",
    "automation"
  ],
  "author": {
    "name": "lchqi1998",
    "url": "https://github.com/lchqi1998"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lchqi1998/dsh-n8n-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/lchqi1998/dsh-n8n-plugin/issues"
  },
  "homepage": "https://github.com/lchqi1998/dsh-n8n-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/store.js && node --check lib/n8n.js && node --check lib/routes.js && node --check lib/http.js && node --check lib/render.js && node --check lib/tool-specs.js && node --check lib/tools.js && node --check lib/guidance.js && node --check lib/mount-once.js && node --check lib/workflow-validate.js && node --check client/index.js && node --check test/workflow-validate.test.js"
  }
}
