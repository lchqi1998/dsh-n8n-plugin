{"name": "错误通知（errorTrigger → 组装 → 推送）", "nodes": [{"id": "error1", "name": "错误触发", "type": "n8n-nodes-base.errorTrigger", "typeVersion": 1, "position": [250, 300], "parameters": {}}, {"id": "set1", "name": "组装消息", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [450, 300], "parameters": {"mode": "manual", "assignments": {"assignments": [{"id": "a1", "name": "workflow", "value": "={{ $json.workflow.name }}", "type": "string"}, {"id": "a2", "name": "node", "value": "={{ $json.execution.lastNodeExecuted }}", "type": "string"}, {"id": "a3", "name": "error", "value": "={{ $json.execution.error.message }}", "type": "string"}, {"id": "a4", "name": "url", "value": "={{ $json.execution.url }}", "type": "string"}]}, "options": {}}}, {"id": "http1", "name": "推送通知", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [650, 300], "parameters": {"url": "https://hooks.example.com/notify", "method": "POST", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ text: '工作流「' + $json.workflow + '」在节点「' + $json.node + '」失败：' + $json.error + '\n' + $json.url }) }}", "options": {"timeout": 10000}}, "retryOnFail": true, "maxTries": 3}], "connections": {"错误触发": {"main": [[{"node": "组装消息", "type": "main", "index": 0}]]}, "组装消息": {"main": [[{"node": "推送通知", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1"}}
