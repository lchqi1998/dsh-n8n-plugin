{"name": "定时同步（schedule → 拉取 → 分批逐条处理）", "nodes": [{"id": "schedule1", "name": "定时触发", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [250, 300], "parameters": {"rule": {"interval": [{"field": "hours", "hoursInterval": 1}]}}}, {"id": "http1", "name": "拉取列表", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [450, 300], "parameters": {"url": "https://api.example.com/items?limit=100", "method": "GET", "options": {"timeout": 15000}}, "retryOnFail": true, "maxTries": 3}, {"id": "split1", "name": "分批处理", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [650, 300], "parameters": {"batchSize": 10, "options": {}}}, {"id": "http2", "name": "逐条上报", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [850, 220], "parameters": {"url": "https://sink.example.com/collect", "method": "POST", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify($json) }}", "options": {"timeout": 10000}}}, {"id": "code1", "name": "汇总结果", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1050, 380], "parameters": {"mode": "runOnceForAllItems", "jsCode": "return $input.all().map((item, i) => ({ json: { index: i, id: item.json.id } }));"}}], "connections": {"定时触发": {"main": [[{"node": "拉取列表", "type": "main", "index": 0}]]}, "拉取列表": {"main": [[{"node": "分批处理", "type": "main", "index": 0}]]}, "分批处理": {"main": [[{"node": "逐条上报", "type": "main", "index": 0}], [{"node": "汇总结果", "type": "main", "index": 0}]]}, "逐条上报": {"main": [[{"node": "分批处理", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1"}}
